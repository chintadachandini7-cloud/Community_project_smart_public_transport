# ============================================================
# SUPABASE CONFIGURATION
# ============================================================
# Find these in: Supabase Dashboard → Settings → API
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Project URL (Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key (Settings → API → Project API keys → anon public)
# Safe for client-side/browser usage. RLS policies enforce access control.
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service Role Key (Settings → API → Project API keys → service_role secret)
# ⚠️ NEVER expose this on the client side! Server-only. Bypasses all RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# JWT Secret (Settings → API → JWT Settings → JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ============================================================
# GOOGLE & FIREBASE CONFIGURATION
# ============================================================
# Google Cloud / Firebase API Key
GOOGLE_API_KEY=AIzaSyDCnxBTdeIZg8oArIh8rRNorm6qaN1EdTU

